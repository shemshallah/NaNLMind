    "paragraphs": {
      "complete_tag": "corpora-paragraphs",
      "batch_tag_pattern": "corpora-paragraphs-{0001..}",
      "book_batch_size": 1000,
      "manifest": "corpora/paragraphs/MANIFEST.json",
      "batches": "corpora/paragraphs/BATCHES.json"
    },
    "short_stories": {
      "complete_tag": "corpora-short-stories",
      "batch_tag_pattern": "corpora-short-stories-{0001..}",
      "book_batch_size": 1000,
      "manifest": "corpora/short_stories/MANIFEST.json",
      "batches": "corpora/short_stories/BATCHES.json"
    }
  },
  "intake": "download one tagged batch, verify SHA256SUMS.parts, expand per-book .txt, feed stream-train/ngram-train/phase-codebook without copying into a repository",

{
  "schema": "nanlm.native-word-projection/1",
  "worker": "build/field_driver.nan",
  "sources": [
    "mth/drivers/field_driver.nas",
    "mth/nan16/mth_word_projection.nas",
    "mth/nan16/unified_projection_entries.nas"
  ],
  "command_modes": {
    "124/0": "build unigram and bigram counts",
    "124/1": "streaming count batch",
    "124/2": "full V-way top-5 and loss"
  },
  "memory": {
    "unigram_base": "0x01310000",
    "bigram_base": "0x00E00000",
    "token_buffer": "0x00060000",
    "top5_scratch": "0x01311000",
    "max_vocabulary": 2292
  },
  "model": {
    "type": "interpolated add-alpha word bigram",
    "unigram": "(count+alpha)/(N+alpha*V)",
    "bigram": "(row_count+alpha)/(row_total+alpha*V)",
    "interpolation": "0.7*bigram + 0.3*unigram",
    "alpha": 0.01
  },
  "measured_alice_full": {
    "train_tokens": 21954,
    "test_tokens": 5489,
    "vocab": 2292,
    "bpb": 1.61621,
    "top1": 0.142467,
    "top5": 0.306978,
    "in_vocab_top1": 0.154698,
    "in_vocab_top5": 0.333333,
    "oov_rate": 0.0790672
  },
  "baseline_parity": {
    "baseline_bpb": 1.61632,
    "baseline_top1": 0.142467,
    "baseline_top5": 0.306978,
    "note": "top-1/top-5 are identical; BPB differs only by guest float32 accumulation"
  },
  "scope": "native full-training-vocabulary word projection; host tokenizes and transports IDs only",
  "limits": "bigram interpolation parity, not a frontier word model and not a 48M/R27 component",
  "tests": [
    "tests/test_word_projection.cpp",
    "tests/test_system_bench.py"
  ]
}

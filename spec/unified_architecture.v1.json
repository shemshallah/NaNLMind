{
  "schema": "nanlm.unified-architecture/1",
  "status": "canonical-main-native-frontier",
  "entrypoint": "include/nanlm/unified_context_runtime.hpp",
  "flow": [
    "native byte/context readout (direct 256-bin, opcode 40 mode 8)",
    "head page checkpoint / 16-slot page loader",
    "64-token causal native worker",
    "persistent per-head memory",
    "256-token chunk summaries",
    "512-slot ring summary bank",
    "native summary retrieval (opcode123)",
    "hierarchical [memory|summaries|local] assembly",
    "candidate/checkpoint gates and readout"
  ],
  "native_kernels": [
    "mth_head_block6.nas",
    "mth_head_block64.nas",
    "mth_head_block64_last.nas",
    "mth_head_state_readout.nas",
    "mth_head_state_readout_train.nas",
    "mth_head_page_train*.nas",
    "mth_context_top5.nas",
    "mth_global_hodge256_f32.nas",
    "mth_meta_attention16_f32.nas",
    "mth_context6_window_stream.nas",
    "mth_shortlist_batch_proposal.nas",
    "mth_context_direct256.nas",
    "mth_word_projection.nas",
    "word_worker.nas"
  ],
  "policy": {
    "canonical_branch": "main",
    "separate_model_paths": false,
    "old_branches": "audit-only; no new architecture may bypass the unified runtime"
  },
  "metrics": [
    "byte BPB/top5 (native direct-256 canonical)",
    "word n-gram BPB/top5 reference",
    "candidate-panel NLL/top1/top5",
    "page/chunk checkpoint gates",
    "external 48M finite-candidate adapter (optional, no metrics claimed)",
    "1B-token native token-level projection (subword tokens, not text-word BPB)"
  ],
  "blocked": [
    "full-vocabulary native word projection",
    "T>2 reverse and weight gradients (arbitrary-length BPTT)",
    "automatic tensor promotion"
  ],
  "entrypoints": {
    "native_frontier_context": "include/nanlm/unified_context_runtime.hpp",
    "native_byte_readout": "mth/nan16/mth_context_direct256.nas",
    "native_64_token_worker": "mth/drivers/head_worker.nas",
    "external_48m_adapter": "tools/unified_48m_runtime.py (optional; R27 archive is not part of this repository)",
    "native_word_projection": "build/word_worker.nan",
    "native_1b_token_trainer": "build/train-1b"
  },
  "language_model_policy": {
    "native_system": "NaNLMind native context/byte/readout path",
    "external_48m": "optional adapter only; R27/48M is not a NaNLMind dependency and no metrics are claimed here",
    "separate_model_paths": false,
    "candidate_only": true
  }
}

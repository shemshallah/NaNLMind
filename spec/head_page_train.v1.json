{
  "schema": "nanlm.head-page-train/1",
  "opcode": 125,
  "image": "build/head_worker.nan",
  "context": "f32[T*128], T=1..6",
  "target": "f32[128] last-token target state",
  "page_slot": "0..15",
  "learning_rate": "finite nonnegative f32",
  "update": {
    "w2": "W2[j,k] += lr*(target[j]-state[j])*hidden[k]",
    "wo": "Wo[j,k] += lr*(target[j]-state[j])*context[k]",
    "w1": "g_h[k]=sum_j W2[j,k]*(target[j]-state[j]); W1[k,d] += lr*g_h[k]*(1-h[k]^2)*xn2[d]",
    "wv": "g_ctx=Wo^T(target-state); Wv[k,d] += lr*sum_j p[j]*g_ctx[k]*xn[j][d]",
    "qk": {
      "g_ctx": "Wo^T(target-state)",
      "d_s[j]": "p[j]*(g_ctx\u00b7V[j] - sum_k p[k]*(g_ctx\u00b7V[k]))",
      "d_q": "sum_j d_s[j]*K[j]/sqrt(128)",
      "d_k[j]": "d_s[j]*Q[last]/sqrt(128)",
      "Wq": "Wq[k,d] += lr*d_q[k]*xn[last][d]",
      "Wk": "Wk[k,d] += lr*sum_j d_k[j][k]*xn[j][d]"
    },
    "l1w2": "W2_layer1[j,k] += lr*(target[j]-state[j])*hidden_layer1[k] (local final-error reuse; no layer-2 backprop)"
  },
  "precision": "bf16 page weights; f32 guest arithmetic",
  "scope": "one local final-layer projection update; not full three-layer backpropagation, optimizer state, or promotion",
  "cli": "build/nanlm-head-page-train <checkpoint-dir> <context.f32> <target.f32> <head> <lr> <epochs> <out-dir> <out.json> [w2|wo|w1|wv|qk|l1w2]",
  "output": "candidate checkpoint page + error norm + source/candidate SHA-256 + generation",
  "host_math": false,
  "tensor_promotion": false,
  "note": "The guest performs forward, error, and W2 update; the host exports the modified page slot and writes a candidate checkpoint.",
  "projection_modes": [
    "w2",
    "wo",
    "w1",
    "wv",
    "qk",
    "l1w2"
  ]
}

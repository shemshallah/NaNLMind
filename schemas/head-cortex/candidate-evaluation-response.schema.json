{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NaNLMind held-out head candidate evaluation response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mutation_id",
    "status",
    "split",
    "dataset_sha256",
    "base_state_digest",
    "candidate_digest",
    "baseline",
    "candidate",
    "utility_delta",
    "recommendation",
    "promotion_allowed",
    "canonical_state_modified",
    "evaluation_policy",
    "balanced_accuracy_nonregression"
  ],
  "properties": {
    "schema": {
      "const": "nanlm.head-candidate-evaluation-response/1"
    },
    "mutation_id": {
      "type": "string"
    },
    "status": {
      "const": "evaluated_candidate"
    },
    "base_state_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidate_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "baseline": {
      "type": "object"
    },
    "candidate": {
      "type": "object"
    },
    "utility_delta": {
      "type": "number"
    },
    "recommendation": {
      "enum": [
        "review_candidate",
        "retain_baseline"
      ]
    },
    "promotion_allowed": {
      "const": false
    },
    "canonical_state_modified": {
      "const": false
    },
    "evaluation_policy": {
      "const": "caller_declared_test_split_no_automatic_promotion"
    },
    "split": {
      "const": "test"
    },
    "dataset_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "balanced_accuracy_nonregression": {
      "type": "boolean"
    }
  }
}

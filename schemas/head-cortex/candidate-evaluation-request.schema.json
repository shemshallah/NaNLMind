{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NaNLMind held-out head candidate evaluation request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mutation_id",
    "split",
    "dataset_sha256",
    "records"
  ],
  "properties": {
    "schema": {
      "const": "nanlm.head-candidate-evaluation-request/1"
    },
    "mutation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resolution",
          "polarity",
          "subject",
          "predicate",
          "object",
          "source_digest"
        ],
        "properties": {
          "resolution": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          },
          "polarity": {
            "enum": [
              "+",
              "-"
            ]
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "predicate": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "object": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "source_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "split": {
      "const": "test"
    },
    "dataset_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}

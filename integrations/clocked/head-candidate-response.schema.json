{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NaNLMind isolated head candidate response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mutation_id",
    "status",
    "head_index",
    "patch_mask",
    "base_topology_digest",
    "candidate_digest",
    "canonical_state_modified",
    "promotion_allowed"
  ],
  "properties": {
    "schema": {
      "const": "nanlm.head-candidate-response/1"
    },
    "mutation_id": {
      "type": "string"
    },
    "status": {
      "const": "candidate_only"
    },
    "head_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "patch_mask": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "base_topology_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidate_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "boolean_mask_before": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "boolean_mask_after": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "boolean_rule_before": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "boolean_rule_after": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "canonical_state_modified": {
      "const": false
    },
    "promotion_allowed": {
      "const": false
    }
  }
}

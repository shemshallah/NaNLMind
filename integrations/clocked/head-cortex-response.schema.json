{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NaNLMind head cortex response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "request_sha256",
    "generation",
    "truth_state",
    "relations",
    "active_heads",
    "abstentions",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "nanlm.head-cortex-response"
    },
    "version": {
      "const": 1
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "truth_state": {
      "enum": [
        "TRUE",
        "FALSE",
        "UNKNOWN",
        "CONFLICT"
      ]
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "subject",
          "predicate",
          "object",
          "truth_state",
          "premises",
          "rule_id"
        ],
        "properties": {
          "subject": {
            "type": "string"
          },
          "predicate": {
            "type": "string"
          },
          "object": {
            "type": "string"
          },
          "truth_state": {
            "enum": [
              "TRUE",
              "FALSE",
              "UNKNOWN",
              "CONFLICT"
            ]
          },
          "premises": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rule_id": {
            "type": "string"
          },
          "head_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    },
    "active_heads": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "abstentions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "provenance": {
      "type": "object"
    },
    "mutation_proposals": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
